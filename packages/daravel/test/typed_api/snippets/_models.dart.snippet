// Shared models of the snippets (not a snippet itself).
import 'package:daravel/daravel.dart';

final class User extends Model {
  static final ModelDefinition<User> definition = ModelDefinition<User>(
    table: 'users',
    factory: User.new,
  );

  @override
  ModelDefinition<User> get modelDefinition => User.definition;

  static const cols = (
    id: ModelColumn<User, int>('id'),
    email: ModelColumn<User, String>('email'),
    age: ModelColumn<User, int?>('age'),
    createdAt: ModelColumn<User, DateTime?>('created_at'),
  );
}

final class Post extends Model {
  static final ModelDefinition<Post> definition = ModelDefinition<Post>(
    table: 'posts',
    factory: Post.new,
  );

  @override
  ModelDefinition<Post> get modelDefinition => Post.definition;

  static const cols = (
    id: ModelColumn<Post, int>('id'),
    title: ModelColumn<Post, String>('title'),
  );

  static const rels = (comments: RelationToken<Post, Comment>('comments'));
}

final class Comment extends Model {
  static final ModelDefinition<Comment> definition = ModelDefinition<Comment>(
    table: 'comments',
    factory: Comment.new,
  );

  @override
  ModelDefinition<Comment> get modelDefinition => Comment.definition;

  static const cols = (
    id: ModelColumn<Comment, int>('id'),
    body: ModelColumn<Comment, String>('body'),
  );

  static const rels = (author: RelationToken<Comment, User>('author'));
}

/// The relations of User, as model:sync writes them.
abstract final class UserRels {
  static const rels = (posts: RelationToken<User, Post>('posts'));
}

// The relation paths, as model:sync writes them next to each model.
extension UserRelationPath<Root extends Model> on RelationToken<Root, User> {
  RelationToken<Root, Post> get posts => nested(UserRels.rels.posts);
}

extension PostRelationPath<Root extends Model> on RelationToken<Root, Post> {
  RelationToken<Root, Comment> get comments => nested(Post.rels.comments);
}

extension CommentRelationPath<Root extends Model>
    on RelationToken<Root, Comment> {
  RelationToken<Root, User> get author => nested(Comment.rels.author);
}
