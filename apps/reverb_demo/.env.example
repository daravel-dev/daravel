APP_NAME="Reverb demo"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_PORT=8000

DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
# reverb:restart reaches the WebSocket server through this store.
QUEUE_SIGNAL_STORE=file
METRICS_ENABLED=true

# The application of the REVERB_APP_* settings: set a random key and a
# secret of 32 characters or more (openssl rand -hex 16 / -hex 32).
REVERB_APP_ID=demo
REVERB_APP_KEY=
REVERB_APP_SECRET=
# 32 random bytes in base64, for private-encrypted- channels.
REVERB_ENCRYPTION_MASTER_KEY_BASE64=

# A second Pusher application on the same server (its own key, secret and
# origins); replace the secret before use.
REVERB_APPS=[{"app_id":"partner","key":"partner-key","secret":"replace-with-32-random-characters","allowed_origins":["localhost","127.0.0.1"],"max_connections":100}]

# The WebSocket server of `dartisan reverb:start`.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SERVER_AUTH=app
REVERB_SERVER_ISOLATES=2

# The HTTP application publishes to it through its HTTP API, and reads its
# numbers for /reverb.
BROADCAST_CONNECTION=reverb
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_METRICS_URL=http://127.0.0.1:8080/metrics
