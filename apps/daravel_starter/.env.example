APP_NAME=Daravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# sqlite (default) | pgsql | mysql
DB_CONNECTION=sqlite
# Relative paths resolve against the project root. Use :memory: for tests.
DB_DATABASE=database/database.sqlite

# token (Sanctum-style personal access tokens) | jwt
AUTH_GUARD=token
# Optional global token lifetime in minutes (unset = until revoked)
# AUTH_TOKEN_EXPIRATION=43200

# argon2id (default) | bcrypt (PHP/Laravel compatible) | pbkdf2
HASH_DRIVER=argon2id
# BCRYPT_ROUNDS=12
# ARGON_MEMORY=65536
# ARGON_TIME=3

# JWT guard (HS256 uses JWT_SECRET, falling back to APP_KEY)
# JWT_SECRET=
# JWT_ALGO=HS256
# JWT_TTL=60

# HTTP worker isolates (>1 runs a supervisor + workers sharing the port)
APP_ISOLATES=1
# SHUTDOWN_TIMEOUT=30s

# memory (per isolate) | process (shared across isolates) | file | database
CACHE_STORE=memory
# CACHE_PREFIX=daravel_cache_
# CACHE_PATH=storage/framework/cache

# sync (inline) | database | memory
QUEUE_CONNECTION=sync
# QUEUE_RETRY_AFTER=90s

# stack | console | json | daily | null
LOG_CHANNEL=stack
LOG_STACK=console
LOG_LEVEL=debug
# LOG_PATH=storage/logs
# LOG_DAILY_DAYS=14

# local (storage/app/private) | public (storage/app/public)
FILESYSTEM_DISK=local

# Prometheus metrics at METRICS_PATH (protect with METRICS_TOKEN)
METRICS_ENABLED=false
# METRICS_PATH=/metrics
# METRICS_TOKEN=
