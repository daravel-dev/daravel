APP_NAME=Daravel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=UTC
APP_LOCALE=en

# sqlite (default) | pgsql | mysql
DB_CONNECTION=sqlite
# Relative paths resolve against the project root. Use :memory: for tests.
DB_DATABASE=database/database.sqlite
