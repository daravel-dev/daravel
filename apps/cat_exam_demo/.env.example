APP_NAME="CAT Exam Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database: sqlite | pgsql | mysql
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Cache store: memory (fast in-memory) | process | redis
CACHE_STORE=memory

# Exam Configuration
EXAM_DURATION_MINUTES=30
EXAM_GRACE_PERIOD_SECONDS=15
