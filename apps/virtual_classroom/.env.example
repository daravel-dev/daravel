APP_NAME="Virtual Classroom"
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Calendar invitations and other jobs; `sync` runs them in the request.
QUEUE_CONNECTION=database

# LiveKit (livekit-server --dev uses devkey / secret).
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Calendar: a service account with access to the calendar. Leave the
# credentials empty to schedule without invitations.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CALENDAR_ID=primary
# Acting as a Workspace user (domain-wide delegation), when needed.
GOOGLE_CALENDAR_IMPERSONATE=
