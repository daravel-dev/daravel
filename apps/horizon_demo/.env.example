APP_NAME="Horizon demo"
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# A SQLite file is enough to try it; use PostgreSQL or MySQL in production
# (a worker killed while writing to SQLite keeps its lock).
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite
QUEUE_CONNECTION=database
QUEUE_SIGNAL_STORE=file

# Horizon (daravel_horizon)
HORIZON_ENABLED=true
HORIZON_PATH=/horizon
HORIZON_HEARTBEAT_MS=1000
HORIZON_KILL_GRACE=10
# Development only: lets the supervisors run on a SQLite file queue.
HORIZON_ALLOW_SQLITE=true
# Runs Horizon inside the HTTP server; or run `dartisan horizon` apart.
SERVER_EMBED_WORKERS=horizon
